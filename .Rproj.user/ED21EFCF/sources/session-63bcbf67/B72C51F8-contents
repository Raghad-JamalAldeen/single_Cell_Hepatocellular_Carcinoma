seu_merged
dim(seu_merged)
new_names <- sub("^([^_]+)_\\1_", "\\1_", colnames(seu_merged))
head(new_names)
seu_merged <- RenameCells(seu_merged, new.names = new_names)
head(colnames(seu_merged))
cell_meta <- fread("data/GSE149614_HCC.metadata.updated.txt.gz")
